<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_home">

    <!-- 1. Fragment Trang chủ (Home) -->
    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.marketplace.ui.home.HomeFragment"
        tools:layout="@layout/fragment_home" />

    <!-- 2. Fragment Đăng bán (Post) -->
    <fragment
        android:id="@+id/nav_post"
        android:name="com.example.marketplace.ui.post.PostFragment" />

    <!-- 3. Fragment Liên hệ (Contact) -->
    <fragment
        android:id="@+id/nav_contact"
        android:name="com.example.marketplace.ui.contact.ContactFragment" />

    <!-- 4. Fragment Cá nhân (Profile) -->
    <fragment
        android:id="@+id/nav_profile"
        android:name="com.example.marketplace.ui.profile.ProfileFragment" />

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.marketplace.ui.search.SearchFragment"
        tools:layout="@layout/fragment_search"/>

</navigation>